.git
.gitignore
.venv
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.coverage

# Exclude private model weights from build context (mounted at runtime)
models/

# Exclude local build artifacts and node_modules
frontend/node_modules
frontend/dist

# Exclude secrets and local env files
.env
.env.*
!.env.example
!.env.production.example

# Exclude local test images and caches
*.jpg
*.jpeg
*.png
!frontend/public/*.png
!frontend/public/*.svg
!frontend/src/**/*.png
!frontend/src/**/*.svg

# Exclude local third-party checkout (cloned deterministically inside container)
third_party/
