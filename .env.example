# API
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_MB=12

# Detector
E2_MODEL_PATH=models/e2/best.pt
E2_DEVICE=cpu
E2_CONF=0.30
E2_IOU=0.70
E2_MAX_DET=100
E2_PRIMARY_IMGSZ=960
E2_RETRY_IMGSZ=1280

# Crop policy
ROI_PADDING=0.05
ROI_SHIFT_X=0.025

# Recognizer
PADDLEOCR_REPO=/opt/PaddleOCR
PPOCR_REC_MODEL_DIR=models/ppocrv6_medium/inference
PPOCR_CHAR_DICT=models/ppocrv6_medium/meter_digits_dict.txt
PPOCR_REC_ALGORITHM=SVTR_LCNet
PPOCR_REC_IMAGE_SHAPE=3,48,320
PPOCR_MAX_TEXT_LENGTH=12
PPOCR_REC_BATCH_NUM=1
PPOCR_USE_GPU=false

# Pipeline
PIPELINE_VERSION=e2-adaptive-ppocrv6-medium-v1
