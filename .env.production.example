# ==============================================================================
# SAIGON PORT METER READING - PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env on the production server.
# Do NOT commit real production passwords, keys, or private domains to Git.

# Application Environment (production disables Swagger /docs and OpenAPI schema)
ENVIRONMENT=production

# Public Domain / Hostname for Caddy Reverse Proxy & Automated SSL/TLS
# For local testing, use: localhost
# For production, replace with the approved company domain (e.g. meter.company.example)
APP_DOMAIN=localhost

# Inference Hardware Device (cpu or cuda)
E2_DEVICE=cpu
PPOCR_USE_GPU=false

# Upload & File Limits
MAX_UPLOAD_MB=12

# Model Storage Paths (Mounted inside container at /app/models)
E2_MODEL_PATH=models/e2/best.pt
PPOCR_REC_MODEL_DIR=models/ppocrv6_medium/inference
PPOCR_CHAR_DICT=models/ppocrv6_medium/meter_digits_dict.txt
PADDLEOCR_REPO=/opt/PaddleOCR
